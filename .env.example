# Copy this file to .env and fill in what you have.
# The app runs with ZERO keys set — every integration below falls back to
# clearly-labeled demo/mock data (see server/services/*) so it stays fully
# inspectable and demoable without any registration.

# LTA DataMall (free, registration required: https://datamall.lta.gov.sg/)
# Powers TrainServiceAlerts, PCDRealTime/PCDForecast crowding, v3/BusArrival,
# RoadWorks, PlannedBusRoutes. Without this, crowding/disruption data is mocked.
LTA_ACCOUNT_KEY=

# OneMap (Singapore government geospatial + routing, free account:
# https://www.onemap.gov.sg/apidocs/register). Primary multi-modal routing
# engine. Without this, routing falls back to the public OSRM demo server
# for walk/cycle legs plus a labeled mock itinerary for the transit legs.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Map tiles. Public OSM tiles are used by default for local dev/demo only
# (their usage policy forbids production traffic) — set one of these for
# anything beyond a hackathon demo recording.
MAPTILER_KEY=
STADIA_API_KEY=

# data.gov.sg weather (nowcast/forecast) needs no key; nothing to set here.

PORT=3001
